# --- Backend (this repo) — used by `npm run dev` / `npm start` ---
# Put VITE_* variables in the frontend project `.env`, not here.
#
# Frontend example (mirror here: PORT=8000, PUBLIC_BASE_URL, CORS origins):
#   VITE_FRONTEND_HOST=0.0.0.0
#   VITE_PORT=5177
#   VITE_API_BASE_URL=http://127.0.0.1:8000

# Listen on all interfaces so LAN clients can reach the API. Use 127.0.0.1 to block remote.
HOST=0.0.0.0
PORT=8000

# Base URL of this API (no trailing slash). Frontend Vite should use the same:
#   VITE_API_BASE_URL=http://127.0.0.1:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
# PUBLIC_BASE_URL=https://urban-api.example.com

# CORS: must include the origin the browser uses (scheme + host + port).
# Default dev origins include 5173 and 5177; FRONTEND_PORT picks your Vite port (e.g. 5177).
FRONTEND_PORT=5177
# Optional extra origins (comma-separated). If you open Vite via LAN IP, add e.g. http://192.168.1.10:5177
FRONTEND_ORIGIN=http://127.0.0.1:5177,http://localhost:5177
# Production example:
# FRONTEND_ORIGIN=https://urban-frontend.example.com

# MySQL (required). On Vercel use a hosted DB — not 127.0.0.1.

# Prefer a single URL (hosting dashboards often expose this). Overrides MYSQL_* fields.
# mysql://USER:PASSWORD@HOST:3306/DATABASE  (special chars in PASSWORD → URL-encode)
# DATABASE_URL=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=urbanx

# TLS: on Vercel, SSL defaults ON (cloud MySQL). Set MYSQL_SSL=0 only if your provider has no TLS.
# Locally, leave unset unless your MySQL expects SSL.
# MYSQL_SSL=1

# Skip RUNTIME schema apply (DB already migrated). Optional on Vercel.
# SKIP_DB_BOOTSTRAP=true

# Show full error text in 503 JSON on Vercel (dev only)
# API_DEBUG_ERRORS=1

JWT_SECRET=change-this-to-a-long-random-string-in-production

DEFAULT_NEW_USER_PASSWORD=TempPass123!

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
