
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_PORT=5177
# Optional extra origins (comma-separated). If you open Vite via LAN IP, add e.g. http://192.168.1.10:5177
FRONTEND_ORIGIN=http://127.0.0.1:5177,http://localhost:5177
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=urbanx

JWT_SECRET=change-this-to-a-long-random-string-in-production

DEFAULT_NEW_USER_PASSWORD=TempPass123!

# First boot only (empty users table): creates superadmin login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin

# 1 = on startup, update that user's password_hash to match SEED_ADMIN_PASSWORD (fixes old DB hashes).
# Turn off in production once passwords are managed only in the DB (RESYNC_ADMIN_PASSWORD=0).
RESYNC_ADMIN_PASSWORD=1
